# AWS Configuration
aws_region = "us-east-1"  # Change to your preferred region

# Project Configuration
project_name = "redhat-deployment"
environment  = "dev"  # Options: dev, staging, prod

# Network Configuration
vpc_cidr           = "10.0.0.0/16"
public_subnet_cidr = "10.0.1.0/24"

# Security Configuration
# IMPORTANT: Restrict SSH access to your IP address for security
# Example: ["203.0.113.0/32"] for a single IP
# To find your IP: curl -4 ifconfig.me
allowed_ssh_cidrs = ["0.0.0.0/0"]  # WARNING: This allows SSH from anywhere - restrict in production

# EC2 Instance Configuration
instance_type = "t3.micro"  # Options: t3.micro, t3.small, t3.medium, t3.large, m5.large, etc.
key_name      = "my-redhat-key"  # Make sure this key pair exists in your AWS region

# Storage Configuration
root_volume_type     = "gp3"    # Options: gp2, gp3, io1, io2
root_volume_size     = 20       # Size in GB (minimum 10)
encrypt_root_volume  = true     # Enable encryption for security

# Optional: Custom user data script
# user_data_script = <<-EOF
#   #!/bin/bash
#   yum update -y
#   yum install -y docker
#   systemctl enable docker
#   systemctl start docker
# EOF